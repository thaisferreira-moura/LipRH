<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#F2F2F2"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <ImageView
            android:id="@+id/imgAvatarExame"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:src="@drawable/ic_user_circle" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/imgAvatarExame"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtNomeExame"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="João Silva"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txtCpfExame"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="123.456.789-00"
                android:textColor="#000000"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <!-- Selo de Envio -->
                <TextView
                    android:id="@+id/txtStatusEnvio"
                    android:layout_width="85dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingVertical="2dp"
                    android:text="Pendente"
                    android:textColor="#000000"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/shape_status_pendente" />

                <!-- Selo de Validação -->
                <TextView
                    android:id="@+id/txtStatusValidacao"
                    android:layout_width="85dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:paddingVertical="2dp"
                    android:text="Validar"
                    android:textColor="#000000"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/shape_status_validar" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/btnVerExame"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_eye_red" />

    </RelativeLayout>
</androidx.cardview.widget.CardView>