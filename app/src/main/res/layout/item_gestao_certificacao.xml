<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#F2F2F2"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <ImageView
            android:id="@+id/imgAvatarCert"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:src="@drawable/ic_user_circle" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/imgAvatarCert"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtNomeCert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="João Silva"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txtCertInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NR10 - Segurança em Eletricidade"
                android:textColor="#444444"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtStatusCert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="2dp"
                android:text="Concluído"
                android:textColor="#000000"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/shape_status_validado" />
        </LinearLayout>

        <ImageView
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/certificacao" />

    </RelativeLayout>
</androidx.cardview.widget.CardView>