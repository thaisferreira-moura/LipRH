<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="4dp"
    app:cardElevation="0dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F8F9FA"
        android:padding="12dp">

        <ImageView
            android:id="@+id/imgIconeExameRealizado"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_exame" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/imgIconeExameRealizado"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtNomeExameRealizado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Colesterol"
                android:textColor="#A52A2A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="realizado em 06/05/2026"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtStatusExame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="#E8F5E9"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="aprovado"
            android:textColor="#4CAF50"
            android:textSize="12sp" />
    </RelativeLayout>
</androidx.cardview.widget.CardView>